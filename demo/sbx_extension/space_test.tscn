[sub_resource type="GDScript" id="GDScript_mnmap"]
script/source = "extends Control

# The top view of wall-rule-tile-16.html around the hero, north up: every brick
# SpaceRenderer draws, seen from above in the color of its key and darker on the
# lower layers, over a tint of the whole cell for the topmost brick of each
# column. The whole map is drawn into a texture on each tile rebuild, and the
# view scrolls it under the hero, across the torus seam. Hovering a cell aims at
# its topmost brick.

const CELL = 24 # pixels per cell
const VIEW = 22 # cells across the view
const MARGIN = 30 # around the view, for the compass
const LEGEND = 56 # below it, two rows
const FONT_SIZE = 17
const INK = Color(0.85, 0.88, 0.9)
const EDGE = Color(0.09, 0.11, 0.13, 0.6)
const AIM = Color(1, 0.85, 0.2) # as the highlight in 3D
const NAMES = ['PILLAR', 'WALL_SW', 'WALL_SE', 'WALL_L', 'FULL', 'STAIR']

@onready var colors: Array = %TileMeshes.COLORS

var map_size: Vector2i
var chunk_size: int
var brick_height: float
var hero_extent: Vector3
var bricks := [[], [], [], []] # per brick layer: [footprint in cells, variant]
var tops := PackedInt32Array() # per cell: layer * 8 + variant of its topmost brick, or -1
var map := SubViewport.new() # the whole map, drawn once per tile rebuild
var map_canvas := Control.new()
var view := Control.new() # the map around the hero, the hero and the aimed cell

var hero := Vector3():
	set(value):
		hero = value
		view.queue_redraw()
var aim = null: # the aimed cell, a Vector2i, or null
	set(value):
		aim = value
		view.queue_redraw()

func _ready() -> void:
	var info: Array = PythonScript.eval('__import__(\"sbx\").playground.instance.map_info()')
	map_size = Vector2i(info[0], info[1])
	chunk_size = info[2]
	brick_height = info[3]
	hero_extent = info[4]
	custom_minimum_size = Vector2(VIEW * CELL + MARGIN * 2, VIEW * CELL + MARGIN * 2 + LEGEND)
	map.size = map_size * CELL
	map.disable_3d = true
	map_canvas.size = Vector2(map_size * CELL)
	map_canvas.draw.connect(draw_map)
	map.add_child(map_canvas)
	add_child(map)
	view.position = Vector2(MARGIN, MARGIN)
	view.size = Vector2(VIEW * CELL, VIEW * CELL)
	view.clip_contents = true
	view.mouse_filter = MOUSE_FILTER_IGNORE
	view.draw.connect(draw_view)
	add_child(view)
	%SpaceRenderer.tiles_rebuilt.connect(refresh)
	refresh()

# the center of `cell` in the view, at its mirror nearest the hero
func cell_center(cell: Vector2i) -> Vector2:
	var d := Vector2(cell) + Vector2(0.5, 0.5) - Vector2(hero.x, hero.z)
	d = Vector2(wrapf(d.x, -map_size.x * 0.5, map_size.x * 0.5), wrapf(d.y, -map_size.y * 0.5, map_size.y * 0.5))
	return view.size * 0.5 + d * CELL

# the cell under `point` in the viewport, or (-1, -1)
func cell_at(point: Vector2) -> Vector2i:
	var local := point - view.global_position
	if not Rect2(Vector2.ZERO, view.size).has_point(local):
		return Vector2i(-1, -1)
	var cell := Vector2i((Vector2(hero.x, hero.z) + (local - view.size * 0.5) / CELL).floor())
	return Vector2i(posmod(cell.x, map_size.x), posmod(cell.y, map_size.y))

# a brick's color on the map: its key's, darker on the lower layers
func color_of(key: int, layer: int) -> Color:
	var color: Color = colors[key]
	return color.darkened(0.2 * (2 - layer)) if layer < 2 else color.lightened(0.25 * (layer - 2))

func refresh() -> void:
	for layer in bricks:
		layer.clear()
	tops.resize(map_size.x * map_size.y)
	tops.fill(-1)
	var tiles := %TileMeshes
	var boxes: Array = %SpaceRenderer.get_tile_boxes()
	var parts: Dictionary = tiles.count_parts(boxes)
	for box in boxes:
		var e: Vector3 = box[0]
		var transforms: PackedFloat32Array = box[1]
		for i in range(0, transforms.size(), 12):
			# the center of one box as SpaceRenderer drew it, which may be a mirror
			# of its slot across the torus seam
			var c := Vector3(transforms[i + 3], transforms[i + 7], transforms[i + 11])
			var layer := floori(c.y / brick_height) + 2
			if layer < 0 or layer > 3:
				continue
			var variant: int = tiles.variant_at(parts, transforms, i, e)
			var cell := Vector2i(floori(c.x), floori(c.z))
			var footprint := Rect2(c.x - e.x - cell.x, c.z - e.z - cell.y, e.x * 2, e.z * 2)
			cell = Vector2i(posmod(cell.x, map_size.x), posmod(cell.y, map_size.y))
			footprint.position += Vector2(cell)
			bricks[layer].append([footprint, variant])
			var index := cell.y * map_size.x + cell.x
			if tops[index] < layer * 8:
				tops[index] = layer * 8 + variant
	map_canvas.queue_redraw()
	map.render_target_update_mode = SubViewport.UPDATE_ONCE
	view.queue_redraw()

func draw_map() -> void:
	map_canvas.draw_rect(Rect2(Vector2.ZERO, map_canvas.size), Color(0.16, 0.18, 0.2))
	# bottom layer first, so every brick covers the ones below it
	for layer in 4:
		for index in tops.size():
			if tops[index] >> 3 == layer:
				var tint := color_of(tops[index] & 7, layer)
				tint.a = 0.28
				var cell := Vector2(index % map_size.x, index / map_size.x)
				map_canvas.draw_rect(Rect2(cell * CELL, Vector2(CELL, CELL)), tint)
		for brick in bricks[layer]:
			var footprint: Rect2 = brick[0]
			var rect := Rect2(footprint.position * CELL, footprint.size * CELL)
			map_canvas.draw_rect(rect, color_of(brick[1], layer))
			map_canvas.draw_rect(rect, EDGE, false, 1.0)
	# chunk borders
	var line := Color(1, 1, 1, 0.18)
	for x in range(0, map_size.x, chunk_size):
		map_canvas.draw_rect(Rect2(x * CELL, 0, 1, map_canvas.size.y), line)
	for z in range(0, map_size.y, chunk_size):
		map_canvas.draw_rect(Rect2(0, z * CELL, map_canvas.size.x, 1), line)

func draw_view() -> void:
	# The map, shifted so that the hero sits in the middle. Two copies a side
	# cover the view wherever the torus seam falls in it.
	var corner := Vector2(hero.x, hero.z) - Vector2(VIEW, VIEW) * 0.5
	var shift := (-Vector2(fposmod(corner.x, map_size.x), fposmod(corner.y, map_size.y)) * CELL).round()
	var texture := map.get_texture()
	for j in 2:
		for i in 2:
			view.draw_texture(texture, shift + Vector2(i * map_size.x, j * map_size.y) * CELL)
	if aim != null:
		view.draw_rect(Rect2(cell_center(aim) - Vector2(CELL, CELL) * 0.5, Vector2(CELL, CELL)), AIM, false, 3.0)
	# the hero's footprint, in the middle
	var extent := Vector2(hero_extent.x, hero_extent.z) * CELL
	var body := Rect2(view.size * 0.5 - extent, extent * 2)
	view.draw_rect(body, Color(1, 1, 1, 0.9))
	view.draw_rect(body, EDGE, false, 2.0)

func _draw() -> void:
	draw_rect(Rect2(Vector2.ZERO, size), Color(0, 0, 0, 0.45))
	var font := get_theme_default_font()
	var middle := view.position + view.size * 0.5
	draw_label(font, Vector2(middle.x, MARGIN * 0.5), 0, 'N  -Z')
	draw_label(font, Vector2(middle.x, MARGIN * 1.5 + view.size.y), 0, 'S  +Z')
	draw_label(font, Vector2(MARGIN * 0.5, middle.y), -PI / 2, 'W  -X')
	draw_label(font, Vector2(MARGIN * 1.5 + view.size.x, middle.y), PI / 2, 'E  +X')
	# legend, in the page's order
	var x := float(MARGIN)
	var y := MARGIN * 2 + view.size.y
	var tiles := %TileMeshes
	for variant in [tiles.FULL, tiles.WALL_SW, tiles.WALL_SE, tiles.WALL_L, tiles.PILLAR, tiles.STAIR]:
		var width := FONT_SIZE + 4 + font.get_string_size(NAMES[variant], HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE).x + 16
		if x > MARGIN and x + width > MARGIN + view.size.x: # onto the next row
			x = MARGIN
			y += FONT_SIZE + 5
		draw_rect(Rect2(x, y + 2, FONT_SIZE - 1, FONT_SIZE - 1), color_of(variant, 2))
		draw_string(font, Vector2(x + FONT_SIZE + 4, y + FONT_SIZE), NAMES[variant], HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE, INK)
		x += width

# `text` centered on `center`, turned by `angle`
func draw_label(font: Font, center: Vector2, angle: float, text: String) -> void:
	var width := font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE).x
	var baseline := (font.get_ascent(FONT_SIZE) - font.get_descent(FONT_SIZE)) * 0.5
	draw_set_transform(center, angle)
	draw_string(font, Vector2(-width * 0.5, baseline), text, HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE, INK)
	draw_set_transform(Vector2.ZERO)
"

[sub_resource type="GDScript" id="GDScript_yt4do"]
script/source = "extends Label

func _physics_process(delta: float) -> void:
	var s = '__import__(\"sbx\").playground.instance.debug_info()'
	text = PythonScript.eval(s) as String
"

[sub_resource type="GDScript" id="GDScript_tools"]
script/source = "extends Control

# The toolbar at the bottom right: one icon per tool, picked with the number
# keys or the mouse wheel, and run by a left click in the world. The icons are
# drawn in the same dimetric view as the map, so a tool looks like what it
# leaves behind.

const SLOT = 52 # one icon
const GAP = 6
const CELL = 13.0 # half a cell's width in an icon
const RISE = 15.0 # how tall a brick stands in one, tall enough to read the steps
const INK = Color(0.85, 0.88, 0.9)
const EDGE = Color(0.09, 0.11, 0.13, 0.6)
const PANEL = Color(0, 0, 0, 0.45)
const ACCENT = Color(1, 0.85, 0.2)
const GONE = Color(0.85, 0.3, 0.25) # the cross of the remove tool
# the name of each tool and the call a left click runs on the playground
const TOOLS = [
	['place', '.place(0)'],
	['remove', '.remove()'],
	['stair W', '.place(1)'],
	['stair N', '.place(2)'],
]

@onready var tiles := %TileMeshes

var selected := 0:
	set(value):
		selected = posmod(value, TOOLS.size())
		queue_redraw()

func _ready() -> void:
	custom_minimum_size = Vector2(TOOLS.size() * SLOT + (TOOLS.size() - 1) * GAP, SLOT)

# what a left click in the world runs
func action() -> String:
	return TOOLS[selected][1]

func _unhandled_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key != null and key.pressed:
		var index := key.physical_keycode - KEY_1
		if index >= 0 and index < TOOLS.size():
			selected = index
			get_viewport().set_input_as_handled()
		return
	var button := event as InputEventMouseButton
	if button == null or not button.pressed:
		return
	if button.button_index == MOUSE_BUTTON_WHEEL_DOWN:
		selected += 1
		get_viewport().set_input_as_handled()
	elif button.button_index == MOUSE_BUTTON_WHEEL_UP:
		selected -= 1
		get_viewport().set_input_as_handled()

# a point of the icon's cell, x and z from -0.5 to 0.5 and y from its floor up
func iso(middle: Vector2, x: float, y: float, z: float) -> Vector2:
	return middle + Vector2((x - z) * CELL, (x + z) * CELL * 0.5 - y * RISE)

# One box, as the dimetric camera sees it: its top, and the +X and +Z sides,
# shaded as the tiles in the map are.
func draw_box(middle: Vector2, lo: Vector3, hi: Vector3, color: Color) -> void:
	draw_colored_polygon(PackedVector2Array([iso(middle, hi.x, hi.y, lo.z), iso(middle, hi.x, hi.y, hi.z),
		iso(middle, hi.x, lo.y, hi.z), iso(middle, hi.x, lo.y, lo.z)]), color.darkened(0.37))
	draw_colored_polygon(PackedVector2Array([iso(middle, lo.x, hi.y, hi.z), iso(middle, hi.x, hi.y, hi.z),
		iso(middle, hi.x, lo.y, hi.z), iso(middle, lo.x, lo.y, hi.z)]), color.darkened(0.2))
	draw_colored_polygon(PackedVector2Array([iso(middle, lo.x, hi.y, lo.z), iso(middle, hi.x, hi.y, lo.z),
		iso(middle, hi.x, hi.y, hi.z), iso(middle, lo.x, hi.y, hi.z)]), color)

# The steps of a stair, drawn from the far one down to the one nearest the
# camera, which is the lowest and the widest.
func draw_stair(middle: Vector2, north: bool, color: Color) -> void:
	for i in range(3, -1, -1):
		var reach := 1.0 - i * 0.25
		var lo := Vector3(-0.5, i * 0.25, -0.5)
		var hi := Vector3(-0.5 + reach, (i + 1) * 0.25, 0.5) if not north else Vector3(0.5, (i + 1) * 0.25, -0.5 + reach)
		draw_box(middle, lo, hi, color)

func draw_tool(index: int, middle: Vector2) -> void:
	var cube_lo := Vector3(-0.5, 0.0, -0.5)
	var cube_hi := Vector3(0.5, 1.0, 0.5)
	if index == 0:
		draw_box(middle, cube_lo, cube_hi, tiles.COLORS[tiles.FULL])
	elif index == 1:
		draw_box(middle, cube_lo, cube_hi, tiles.COLORS[tiles.FULL].darkened(0.45))
		var arm := Vector2(11, 11)
		draw_line(middle - arm + Vector2(0, -6), middle + arm + Vector2(0, -6), GONE, 3.0)
		draw_line(middle + Vector2(arm.x, -arm.y - 6), middle + Vector2(-arm.x, arm.y - 6), GONE, 3.0)
	else:
		draw_stair(middle, index == 3, tiles.COLORS[tiles.STAIR])

func _draw() -> void:
	var font := get_theme_default_font()
	for i in TOOLS.size():
		var rect := Rect2(i * (SLOT + GAP), 0, SLOT, SLOT)
		draw_rect(rect, PANEL)
		draw_rect(rect, ACCENT if i == selected else EDGE, false, 2.0)
		draw_tool(i, rect.position + Vector2(SLOT * 0.5, SLOT * 0.78))
		draw_string(font, rect.position + Vector2(5, 15), str(i + 1), HORIZONTAL_ALIGNMENT_LEFT, -1, 13,
			ACCENT if i == selected else INK)
"

