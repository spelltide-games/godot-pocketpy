[sub_resource type="GDScript" id="GDScript_k0hn8"]
script/source = "extends Node3D

@export var speed = 2

const PLAYGROUND = '__import__(\"sbx\").playground.instance'
# How far back from the hero the camera sits. It is orthographic, so this only
# keeps the map between its near and far planes.
const CAMERA_DISTANCE = 20.0
# The tile sizes to pick the camera's pitch by: the top of a cell, seen along the
# 45 degree yaw, is as wide on screen as its diagonal and sin(pitch) times as
# high, so a TILE_WIDTH x height tile takes the pitch asin(height / TILE_WIDTH).
# The list of views ends with one more, looking north: yaw 0, pitch 45.
const TILE_WIDTH = 32
const TILE_HEIGHTS = [[16, '2:1'], [18, '16:9'], [20, '8:5'], [22, '16:11'], [24, '4:3'], [28, '8:7'], [32, '1:1']]
const START_TILE_HEIGHT = 24 # the view the scene starts in, 32x24
const GROUND_LAYERS = 2 # brick layer l stands at (l - GROUND_LAYERS) * brick height
# Stairs move the hero's feet a quarter of a brick at a time, which the camera
# would show as a jump. Smoothed, it keeps what it owes the hero as an offset
# and closes it at a steady speed, this much faster than the hero climbs, so
# the view rises evenly while the feet step. The offset never passes one brick,
# so a long fall or a teleport carries the camera along rather than leaving it.
const CAMERA_CATCH_UP = 1.2

@onready var camera: Camera3D = $Camera3D
@onready var highlight: MeshInstance3D = $Highlight

var brick_height: float # the height of one brick layer
var hero_extent: Vector3 # half the hero's size
var camera_height: float # the height the camera follows, the hero's own when it is not smoothed

func _ready() -> void:
	var info: Array = PythonScript.eval(PLAYGROUND + '.map_info()')
	brick_height = info[3]
	hero_extent = info[4]
	# start the camera at the hero's own height rather than easing up to it
	var hero: Vector3 = PythonScript.eval(PLAYGROUND + '.space.body_get_position(' + PLAYGROUND + '.hero)')
	camera_height = hero.y
	# The marker is a sheet lying on the plane under the hero's feet, a little
	# wider than a cell so that it covers the top of the brick below it.
	var sheet := PlaneMesh.new()
	sheet.size = Vector2(1.04, 1.04)
	highlight.mesh = sheet
	for tile in TILE_HEIGHTS:
		%TileSize.add_item('%d×%d  %s  %.2f°' % [TILE_WIDTH, tile[0], tile[1], pitch_of(tile[0])])
	%TileSize.add_item('yaw 0°  pitch 45.00°')
	%TileSize.item_selected.connect(set_view)
	var start: int = TILE_HEIGHTS.map(func(tile): return tile[0]).find(START_TILE_HEIGHT)
	%TileSize.select(start)
	set_view(start)

static func pitch_of(tile_height: int) -> float:
	return rad_to_deg(asin(float(tile_height) / TILE_WIDTH))

# Turns the camera to the view at `index` in the list: a tile size at the 45
# degree yaw, or after them, yaw 0 and pitch 45.
func set_view(index: int) -> void:
	if index < TILE_HEIGHTS.size():
		camera.rotation_degrees = Vector3(-pitch_of(TILE_HEIGHTS[index][0]), 45, 0)
	else:
		camera.rotation_degrees = Vector3(-45, 0, 0)

func _physics_process(delta: float) -> void:
	# The arrows and WASD, by where they sit rather than what they print, move the
	# hero along the screen, as spelltide's Game.py does: turned back by the
	# camera's yaw, at 45 degrees right is +X-Z and up is -X-Z, at 0 right is +X
	# and up is -Z. Held together they never add up to more than walking speed.
	var arrows := Input.get_vector('ui_left', 'ui_right', 'ui_up', 'ui_down')
	var wasd := Vector2(
		float(Input.is_physical_key_pressed(KEY_D)) - float(Input.is_physical_key_pressed(KEY_A)),
		float(Input.is_physical_key_pressed(KEY_S)) - float(Input.is_physical_key_pressed(KEY_W)))
	var move: Vector2 = (arrows + wasd).limit_length(1.0).rotated(-camera.rotation.y) * speed
	# spelled as a Python literal; held down, the hero jumps again as it lands
	var jump = 'True' if Input.is_key_pressed(KEY_SPACE) else 'False'
	var s = PLAYGROUND + '.move_hero_and_step({0}, {1}, {2}, {3})'
	var pos: Vector3 = PythonScript.eval(s.format([move.x, move.y, delta, jump]))
	camera.position = follow_height(pos, delta) + camera.basis.z * CAMERA_DISTANCE
	%TileMeshes.set_hero(pos, hero_extent)
	aim()
	%Minimap.hero = pos

# The point the camera looks at: the hero, with its height eased after it while
# %Smooth is on, so a stair does not jump the whole view. Only the height is
# eased; the hero walks smoothly on the other two axes, and lagging them would
# only drag the cursor behind the map.
func follow_height(pos: Vector3, delta: float) -> Vector3:
	if not %Smooth.button_pressed:
		camera_height = pos.y
		return pos
	# what the hero's move just opened up, on top of what was left of the last
	var offset := clampf(camera_height - pos.y, -brick_height, brick_height)
	# One cell of a stair climbs a whole brick, so the hero rises at its walking
	# speed times the brick height.
	var catch_up: float = speed * brick_height * CAMERA_CATCH_UP
	camera_height = pos.y + move_toward(offset, 0.0, catch_up * delta)
	return Vector3(pos.x, camera_height, pos.z)

func _unhandled_input(event: InputEvent) -> void:
	var button := event as InputEventMouseButton
	if button == null or not button.pressed:
		return
	var edit := ''
	if button.button_index == MOUSE_BUTTON_LEFT:
		edit = %Tools.action() # whichever tool the toolbar has selected
	elif button.button_index == MOUSE_BUTTON_RIGHT:
		edit = '.remove()'
	if edit and PythonScript.eval(PLAYGROUND + edit):
		%SpaceRenderer.rebuild_tiles()
		aim()

# Aims at the cell under the cursor on the minimap, at nothing under the other
# panels or the open list of tile sizes, which take the clicks there, or
# anywhere else where the ray through the cursor crosses the plane y = 0, and
# shows where.
func aim() -> void:
	var mouse := get_viewport().get_mouse_position()
	var s: String
	var over_hud: bool = %Info.get_global_rect().has_point(mouse) or %View.get_global_rect().has_point(mouse) or %Tools.get_global_rect().has_point(mouse)
	if over_hud or %TileSize.get_popup().visible:
		s = '.aim_clear()'
	elif %Minimap.get_global_rect().has_point(mouse):
		var cell: Vector2i = %Minimap.cell_at(mouse)
		s = '.aim_cell({0}, {1})'.format([cell.x, cell.y]) if cell.x >= 0 else '.aim_clear()'
	else:
		var o := camera.project_ray_origin(mouse)
		var d := camera.project_ray_normal(mouse)
		s = '.aim_ray({0}, {1}, {2}, {3}, {4}, {5})'.format([o.x, o.y, o.z, d.x, d.y, d.z])
	var aim = PythonScript.eval(PLAYGROUND + s) # a Vector3i of cell and plane layer, or null
	highlight.visible = aim != null
	if aim != null:
		# Brick layer l stands at (l - GROUND_LAYERS) * brick_height, and the sheet
		# lies on that plane, just clear of the brick top it covers.
		highlight.position = Vector3(aim.x + 0.5, (aim.z - GROUND_LAYERS) * brick_height + 0.01, aim.y + 0.5)
	%Minimap.aim = Vector2i(aim.x, aim.y) if aim != null else null
"

[sub_resource type="GDScript" id="GDScript_7ngx2"]
script/source = "@tool
extends SpaceDebugDraw

# emitted once the tiles are drawn anew, for the tile meshes and the minimap
signal tiles_rebuilt

var p_space: int

func _ready() -> void:
	var s = '__import__(\"sbx\").playground.instance.space.get_ptr()'
	p_space = PythonScript.eval(s)
	print('p_space: %d' % p_space)
	rebuild_tiles()

func rebuild_tiles() -> void:
	rebuild(p_space, true, 1, 1, 1)
	tiles_rebuilt.emit()

func _physics_process(_delta: float) -> void:
	if not Engine.is_editor_hint():
		rebuild(p_space, false, 1, 1, 1)
		#print('FPS: ', Engine.get_frames_per_second())
"

[sub_resource type="GDScript" id="GDScript_t1les"]
script/source = "extends Node3D

# Lit boxes for the tiles, made from the boxes SpaceRenderer draws as wireframes
# instead of reading the tilemap again: one MultiMesh per box size, which for
# the playground's bricks is one per rule-tile key. Their shader dithers away,
# each whole, the bricks above the ground that hide part of the diamond under
# the hero's feet, the top of the cell it stands in, from the camera.

# Shrinks each box on every side, which keeps neighboring tiles apart and the
# debug wireframe on a tile's edges in view.
const INSET = 0.02
# the variants of wall-rule-tile-16.html, as sbx/playground.py numbers them
const PILLAR = 0
const WALL_SW = 1
const WALL_SE = 2
const WALL_L = 3
const FULL = 4
const STAIR = 5 # not a rule-tile variant: a stair tile, drawn as its steps
const STAIR_PARTS = 4
const COLORS = [
	Color('#ad6698'), # PILLAR
	Color('#d88a48'), # WALL_SW
	Color('#4a8bc3'), # WALL_SE
	Color('#5ba16a'), # WALL_L
	Color('#8f98a1'), # FULL
	Color('#c9a227'), # STAIR
]

@export var cutaway: Shader # the tiles' shader

var instances := {} # [box extent, variant] -> its MultiMeshInstance3D
var brick_height: float # the height of one layer, which tells slots apart

# A brick fills the west half of its cell only toward a west neighbor, and the
# north half only toward a north one, so the size of a single box gives its
# variant. The L is the one made of two boxes, which count_parts() finds.
static func variant_of(extent: Vector3) -> int:
	var west := extent.x > 0.375
	var north := extent.z > 0.375
	if west:
		return FULL if north else WALL_SW
	return WALL_SE if north else PILLAR

# The slot a box sits in: its cell and its layer. A stair's steps stand at four
# heights inside one layer, so the layer, not the height, is what groups them.
func slot_of(transforms: PackedFloat32Array, i: int) -> Vector3:
	return Vector3(floorf(transforms[i + 3]), floorf(transforms[i + 7] / brick_height), floorf(transforms[i + 11]))

# What the box at `i` belongs to, by how many boxes share its slot: four are a
# stair's steps, two are the L, the only rule-tile variant made of two parts,
# and one box gives its variant by its size.
func variant_at(parts: Dictionary, transforms: PackedFloat32Array, i: int, extent: Vector3) -> int:
	var count: int = parts[slot_of(transforms, i)]
	if count >= STAIR_PARTS:
		return STAIR
	return WALL_L if count > 1 else variant_of(extent)

# How many boxes each slot holds.
func count_parts(boxes: Array) -> Dictionary:
	var parts := {}
	for box in boxes:
		var transforms: PackedFloat32Array = box[1]
		for i in range(0, transforms.size(), 12):
			var slot := slot_of(transforms, i)
			parts[slot] = parts.get(slot, 0) + 1
	return parts

func _ready() -> void:
	brick_height = PythonScript.eval('__import__(\"sbxcpp\").space.get_tile_brick_height()')
	%SpaceRenderer.tiles_rebuilt.connect(refresh)
	refresh()

func refresh() -> void:
	for instance in instances.values():
		instance.visible = false
	var boxes: Array = %SpaceRenderer.get_tile_boxes()
	var parts := count_parts(boxes)
	for box in boxes:
		var extent: Vector3 = box[0]
		var transforms: PackedFloat32Array = box[1]
		# One box size can serve two variants, because an L is drawn as the parts
		# it is made of, so the group is split by variant before it is uploaded.
		var buffers := {}
		for i in range(0, transforms.size(), 12):
			var variant := variant_at(parts, transforms, i, extent)
			if not buffers.has(variant):
				buffers[variant] = PackedFloat32Array()
			buffers[variant].append_array(transforms.slice(i, i + 12))
		for variant in buffers:
			var buffer: PackedFloat32Array = buffers[variant]
			var key := [extent, variant]
			var instance: MultiMeshInstance3D = instances.get(key)
			if instance == null:
				instance = create_instance(extent, variant)
				instances[key] = instance
			instance.multimesh.instance_count = buffer.size() / 12
			instance.multimesh.buffer = buffer
			instance.visible = true

# The middle of the hero's body and half its size, for the bricks that hide the
# diamond under its feet to open up.
func set_hero(middle: Vector3, extent: Vector3) -> void:
	for instance in instances.values():
		var material: ShaderMaterial = instance.multimesh.mesh.material
		material.set_shader_parameter('hero', middle)
		material.set_shader_parameter('hero_extent', extent)

func create_instance(extent: Vector3, variant: int) -> MultiMeshInstance3D:
	var material := ShaderMaterial.new()
	material.shader = cutaway
	material.set_shader_parameter('albedo', COLORS[variant])
	var mesh := BoxMesh.new()
	mesh.size = extent * 2 - Vector3.ONE * INSET * 2
	material.set_shader_parameter('half_size', mesh.size * 0.5)
	mesh.material = material
	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = mesh
	var instance := MultiMeshInstance3D.new()
	instance.multimesh = multimesh
	add_child(instance)
	return instance
"

[sub_resource type="Shader" id="Shader_cutaway"]
code = "shader_type spatial;
// what a StandardMaterial3D uses: a shader naming neither gets Lambert and no specular
render_mode diffuse_burley, specular_schlick_ggx;

// The tiles, lit as a StandardMaterial3D of the same albedo, with all but one
// pixel in each 2x2 cut out of every brick whose cell hides part of the diamond
// under the hero's feet, the top of the cell it stands in, from the camera, so
// that where it stands shows through: the simplest dithered cutaway. A brick is
// cut whole or not at all; the ground, layers 0 and 1, never is, and neither is
// anything in the hero's own cell, such as the stair it stands on.
uniform vec4 albedo : source_color = vec4(1.0);
uniform vec3 half_size; // of this material's bricks, as drawn
uniform vec3 hero; // the middle of the hero's body
uniform vec3 hero_extent; // half its size

varying flat float cut; // 1 on a brick to cut, the same at all its vertices

// Whether the ray t * d, t > 0, meets the box [lo, hi].
bool ray_meets(vec3 d, vec3 lo, vec3 hi) {
	float t0 = 0.0;
	float t1 = 1e30;
	for (int k = 0; k < 3; k++) {
		if (abs(d[k]) < 1e-6) {
			if (lo[k] > 0.0 || hi[k] < 0.0) {
				return false;
			}
		} else {
			float a = lo[k] / d[k];
			float b = hi[k] / d[k];
			t0 = max(t0, min(a, b));
			t1 = min(t1, max(a, b));
		}
	}
	return t0 < t1;
}

void vertex() {
	// The diamond is the top of the cell under the hero's feet, at their height.
	// A ray from the camera meets the brick before the diamond where a point p of
	// the brick is q + t * d for a point q of the diamond and some t > 0, d
	// pointing back toward the camera, the same for every ray of this orthographic
	// camera. So the brick hides the diamond when the ray t * d meets the box of
	// all p - q.
	vec3 feet = hero - vec3(0.0, hero_extent.y, 0.0);
	vec3 diamond = vec3(floor(feet.x) + 0.5, feet.y, floor(feet.z) + 0.5); // its middle
	vec3 half_cell = vec3(0.5, 0.0, 0.5);
	// The brick is judged by the whole cell it sits in, at its own height, so
	// that the two boxes an L is drawn as are always cut together.
	vec3 brick = MODEL_MATRIX[3].xyz; // the middle of this box
	vec3 lo = vec3(floor(brick.x), brick.y - half_size.y, floor(brick.z));
	vec3 hi = lo + vec3(1.0, 2.0 * half_size.y, 1.0);
	vec3 d = INV_VIEW_MATRIX[2].xyz; // the camera's +Z
	bool ground = brick.y < 0.0; // layers 0 and 1 lie below y = 0
	// Nor is the cell the hero stands in ever cut. Judging a brick by its whole
	// cell reads the treads of the stair it stands on, which fill only a part of
	// theirs, as standing over the diamond, and the stair breaks up under it.
	bool own_cell = lo.x == diamond.x - 0.5 && lo.z == diamond.z - 0.5;
	cut = !ground && !own_cell && ray_meets(d, lo - diamond - half_cell, hi - diamond + half_cell) ? 1.0 : 0.0;
}

void fragment() {
	ALBEDO = albedo.rgb;
	// a cut brick keeps the pixels at even x and y, one in each 2x2
	if (cut > 0.5 && ((int(FRAGCOORD.x) | int(FRAGCOORD.y)) & 1) != 0) {
		discard;
	}
}
"

[sub_resource type="Shader" id="Shader_sheet"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_disabled, depth_draw_never;

// A sheet of light lying on the plane under the hero's feet, over the aimed
// cell: dim inside and bright along its four edges.
uniform vec4 color : source_color = vec4(1.0, 0.85, 0.2, 0.5);

void fragment() {
	vec2 side = abs(UV - 0.5) * 2.0;
	float edge = smoothstep(0.8, 1.0, max(side.x, side.y));
	ALBEDO = color.rgb;
	ALPHA = color.a * (0.35 + 1.65 * edge);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sheet"]
render_priority = 0
shader = SubResource("Shader_sheet")
shader_parameter/color = Color(1, 0.85, 0.2, 0.5)

[sub_resource type="Environment" id="Environment_sun"]
